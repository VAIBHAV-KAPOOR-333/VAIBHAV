#.env
# ==========================
# DATABASE CONFIGURATION
# ==========================
# SQLAlchemy connection string
# format: mysql+pymysql://<username>:<password>@<host>:<port>/<db_name>
DATABASE_URL=mysql+pymysql://wbuser:newpassword123@127.0.0.1:3306/fastapi_db

# ==========================
# JWT AUTHENTICATION
# ==========================
# Secret key used to sign JWT tokens
SECRET_KEY=SUPER_SECRET_KEY_CHANGE_ME

# Algorithm used for JWT signing
ALGORITHM=HS256

# ==========================
# EMAIL CONFIGURATION
# ==========================
# SMTP server details (Gmail example)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Gmail email ID
SMTP_USER=your_email@gmail.com

# Gmail App Password (NOT normal password)
SMTP_PASSWORD=your_app_password

# From email address
FROM_EMAIL=your_email@gmail.com
